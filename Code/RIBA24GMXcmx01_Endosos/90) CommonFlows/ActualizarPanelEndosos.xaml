        <InArgument x:TypeArguments="x:String">[If(IndiceItemPanel_Int &gt; 0 AndAlso TotalItemsPanel_Int &gt; 0, String.Join("||", PasosTexto_Str.Split(New String() {"||"}, StringSplitOptions.None).Select(Function(texto, indice) If(((indice &gt;= 10 AndAlso indice &lt;= 13) OrElse (indice &gt;= 16 AndAlso indice &lt;= 17)), texto + " - Poliza " + IndiceItemPanel_Int.ToString + " de " + TotalItemsPanel_Int.ToString + If(String.IsNullOrWhiteSpace(IdentificadorItemPanel_Str), String.Empty, " (" + IdentificadorItemPanel_Str + ")"), texto))), PasosTexto_Str)]</InArgument>
