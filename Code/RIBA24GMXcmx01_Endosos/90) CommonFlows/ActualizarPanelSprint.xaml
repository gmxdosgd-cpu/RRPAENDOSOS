    <ui:InvokeCode sap2010:Annotation.AnnotationText="Plantilla comun para publicar en Cloudflare el JSON que acaba de actualizar el sprint." Code="Try&#xA;    Dim publicarCloudflareTexto As String = If(io_publicarCloudflare_Str, &quot;&quot;).Trim()&#xA;    If Not publicarCloudflareTexto.Equals(&quot;True&quot;, StringComparison.OrdinalIgnoreCase) Then&#xA;        Return&#xA;    End If&#xA;&#xA;    Dim rutaArchivoLocal As String = If(io_rutaJson_Str, &quot;&quot;).Trim()&#xA;    Dim urlBaseCloudflare As String = If(io_cloudflareUrlBase_Str, &quot;&quot;).Trim().TrimEnd(&quot;/&quot;c)&#xA;    Dim tokenCloudflare As String = If(io_cloudflareApiToken_Str, &quot;&quot;).Trim()&#xA;&#xA;    If String.IsNullOrWhiteSpace(rutaArchivoLocal) OrElse Not System.IO.File.Exists(rutaArchivoLocal) Then&#xA;        Return&#xA;    End If&#xA;&#xA;    If String.IsNullOrWhiteSpace(urlBaseCloudflare) Then&#xA;        Return&#xA;    End If&#xA;&#xA;    Dim sprintId As String = System.IO.Path.GetFileNameWithoutExtension(rutaArchivoLocal)&#xA;    sprintId = If(sprintId, &quot;&quot;).Trim().ToLowerInvariant()&#xA;    If String.IsNullOrWhiteSpace(sprintId) Then&#xA;        Return&#xA;    End If&#xA;&#xA;    Dim endpoint As String = urlBaseCloudflare &amp; &quot;/api/sprints/&quot; &amp; Uri.EscapeDataString(sprintId)&#xA;    Dim payloadJson As String = System.IO.File.ReadAllText(rutaArchivoLocal, System.Text.Encoding.UTF8)&#xA;&#xA;    Try&#xA;        System.Net.ServicePointManager.SecurityProtocol = CType(3072, System.Net.SecurityProtocolType)&#xA;    Catch&#xA;    End Try&#xA;&#xA;    Using cliente As New System.Net.WebClient()&#xA;        cliente.Encoding = System.Text.Encoding.UTF8&#xA;        cliente.Headers(&quot;Accept&quot;) = &quot;application/json&quot;&#xA;        cliente.Headers(&quot;Content-Type&quot;) = &quot;application/json&quot;&#xA;        cliente.Headers(&quot;User-Agent&quot;) = &quot;UiPath-RPA-Panel-Cloudflare&quot;&#xA;&#xA;        If Not String.IsNullOrWhiteSpace(