    <ui:InvokeCode ContinueOnError="{x:Null}" sap2010:Annotation.AnnotationText="Plantilla comun para actualizar el sprint en el panel web sin repetir la logica en cada robot." Code="Try&#xA;    Dim rutaArchivo As String = If(io_rutaJson_Str, &quot;&quot;).Trim()&#xA;    If String.IsNullOrWhiteSpace(rutaArchivo) Then&#xA;        Return&#xA;    End If&#xA;&#xA;    Dim rutaCarpeta As String = System.IO.Path.GetDirectoryName(rutaArchivo)&#xA;    If Not String.IsNullOrWhiteSpace(rutaCarpeta) AndAlso Not System.IO.Directory.Exists(rutaCarpeta) Then&#xA;        System.IO.Directory.CreateDirectory(rutaCarpeta)&#xA;    End If&#xA;&#xA;    Dim nombreSprintSeguro As String = If(io_nombreSprint_Str, &quot;&quot;).Trim()&#xA;    Dim mensajeErrorSeguro As String = If(io_mensajeError_Str, &quot;&quot;).Trim()&#xA;    Dim mensajeErrorLimpio As String = mensajeErrorSeguro&#xA;    mensajeErrorLimpio = mensajeErrorLimpio.Replace(&quot;La excepción del sistema es:&quot;, &quot;&quot;).Replace(&quot;La excepción de sistema es:&quot;, &quot;&quot;).Replace(&quot;La excepcion del sistema es:&quot;, &quot;&quot;).Replace(&quot;La excepcion de sistema es:&quot;, &quot;&quot;).Replace(&quot;la excepción del sistema es:&quot;, &quot;&quot;).Replace(&quot;la excepción de sistema es:&quot;, &quot;&quot;).Replace(&quot;la excepcion del sistema es:&quot;, &quot;&quot;).Replace(&quot;la excepcion de sistema es:&quot;, &quot;&quot;).Replace(&quot;la posible causa del error es:&quot;, &quot;&quot;)&#xA;    mensajeErrorLimpio = mensajeErrorLimpio.Trim().TrimStart(&quot;_&quot;c, &quot;:&quot;c, &quot;-&quot;c, &quot; &quot;c)&#xA;    Dim mensajeErrorPantalla As String = &quot;&quot;&#xA;    If Not String.IsNullOrWhiteSpace(mensajeErrorLimpio) Then&#xA;        mensajeErrorPantalla = &quot;la posible causa del error es: &quot; &amp; mensajeErrorLimpio.Trim()&#xA;    End If&#xA;&#xA;    Dim pasosSeparados As String() = If(String.IsNullOrWhiteSpace(io_pasosTexto_Str), New String() {}, io_pasosTexto_Str.Split(New String() {&quot;||&quot;}, StringSplitOptions.None))&#xA;    Dim descripcionesSeparadas As String() = If(String.IsNullOrWhiteSpace(io_descripcionesTexto_Str), New String() {}, io_descripcionesTexto_Str.Split(New String() {&quot;||&quot;}, StringSplitOptions.None))&#xA;&#xA;    If pasosSeparados.Length = 0 Then&#xA;        pasosSeparados = New String() {If(String.IsNullOrWhiteSpace(nombreSprintSeguro), &quot;Paso 1&quot;, nombreSprintSeguro)}&#xA;    End If&#xA;&#xA;    If descripcionesSeparadas.Length = 0 Then&#xA;        descripcionesSeparadas = CType(pasosSeparados.Clone(), String())&#xA;    End If&#xA;&#xA;    Dim pasoActualTexto As String = If(i_pasoActual_Str, &quot;&quot;).Trim()&#xA;    Dim pasoActualNumero As Integer = 0&#xA;    Dim coincidenciaPaso As System.Text.RegularExpressions.Match = System.Text.RegularExpressions.Regex.Match(pasoActualTexto, &quot;\d+&quot;)&#xA;    If coincidenciaPaso.Success Then&#xA;        Integer.TryParse(coincidenciaPaso.Value, pasoActualNumero)&#xA;    End If&#xA;&#xA;    If pasoActualNumero &lt;= 0 Then&#xA;        pasoActualNumero = 1&#xA;    End If&#xA;&#xA;    If pasoActualNumero &gt; pasosSeparados.Length Then&#xA;        pasoActualNumero = pasosSeparados.Length&#xA;    End If&#xA;&#xA;    Dim finalizarProcesoValor As Boolean = If(io_finalizarProceso_Str, &quot;&quot;).Trim().Equals(&quot;True&quot;, StringComparison.OrdinalIgnoreCase)&#xA;    Dim ahora As DateTime = DateTime.Now&#xA;    Dim horaActual As String = ahora.ToString(&quot;HH:mm:ss&quot;)&#xA;    Dim formatoFecha As String = &quot;yyyy-MM-dd HH:mm:ss&quot;&#xA;    Dim inicioSprint As DateTime = ahora&#xA;    Dim jsonAnterior As String = &quot;&quot;&#xA;    Dim estadoPrevioPorPaso As New System.Collections.Generic.Dictionary(Of Integer, String)()&#xA;    Dim horaPreviaPorPaso As New System.Collections.Generic.Dictionary(Of Integer, String)()&#xA;    Dim nombrePrevioPorPaso As New System.Collections.Generic.Dictionary(Of Integer, String)()&#xA;    Dim descripcionPreviaPorPaso As New System.Collections.Generic.Dictionary(Of Integer, String)()&#xA;    Dim pasoEnProcesoPrevio As Integer = 0&#xA;&#xA;    If System.IO.File.Exists(rutaArchivo) Then&#xA;        jsonAnterior = System.IO.File.ReadAllText(rutaArchivo)&#xA;&#xA;        Dim claveInicio As String = &quot;&quot;&quot;startedAt&quot;&quot;: &quot;&quot;&quot;&#xA;        Dim indiceInicio As Integer = jsonAnterior.IndexOf(claveInicio)&#xA;        If indiceInicio &gt;= 0 Then&#xA;            indiceInicio = indiceInicio + claveInicio.Length&#xA;            Dim indiceFin As Integer = jsonAnterior.IndexOf(&quot;&quot;&quot;&quot;, indiceInicio)&#xA;            If indiceFin &gt; indiceInicio Then&#xA;                Dim textoInicio As String = jsonAnterior.Substring(indiceInicio, indiceFin - indiceInicio)&#xA;                If Not String.IsNullOrWhiteSpace(textoInicio) Then&#xA;                    Try&#xA;                        inicioSprint = DateTime.Parse(textoInicio)&#xA;                    Catch&#xA;                        inicioSprint = ahora&#xA;                    End Try&#xA;                End If&#xA;            End If&#xA;        End If&#xA;&#xA;        Dim expresionPasos As String = &quot;&quot;&quot;step_number&quot;&quot;\s*:\s*(\d+).*?&quot;&quot;step_name&quot;&quot;\s*:\s*&quot;&quot;((?:\\.|[^&quot;&quot;])*)&quot;&quot;.*?&quot;&quot;status&quot;&quot;\s*:\s*&quot;&quot;([^&quot;&quot;]*)&quot;&quot;.*?&quot;&quot;description&quot;&quot;\s*:\s*&quot;&quot;((?:\\.|[^&quot;&quot;])*)&quot;&quot;.*?&quot;&quot;updated_at&quot;&quot;\s*:\s*&quot;&quot;([^&quot;&quot;]*)&quot;&quot;&quot;&#xA;        For Each coincidencia As System.Text.RegularExpressions.Match In System.Text.RegularExpressions.Regex.Matches(jsonAnterior, expresionPasos, System.Text.RegularExpressions.RegexOptions.Singleline)&#xA;            Dim numeroPasoPrevio As Integer = 0&#xA;            If Integer.TryParse(coincidencia.Groups(1).Value, numeroPasoPrevio) Then&#xA;                Dim estadoPrevioNormalizado As String = coincidencia.Groups(3).Value&#xA;                If estadoPrevioNormalizado.Equals(&quot;Pausado&quot;, StringComparison.OrdinalIgnoreCase) Then&#xA;                    estadoPrevioNormalizado = &quot;En proceso&quot;&#xA;                End If&#xA;                estadoPrevioPorPaso(numeroPasoPrevio) = estadoPrevioNormalizado&#xA;                nombrePrevioPorPaso(numeroPasoPrevio) = coincidencia.Groups(2).Value.Replace(ChrW(92) &amp; ChrW(34), ChrW(34)).Replace(ChrW(92) &amp; ChrW(92), ChrW(92))&#xA;                descripcionPreviaPorPaso(numeroPasoPrevio) = coincidencia.Groups(4).Value.Replace(ChrW(92) &amp; &quot;n&quot;, Environment.NewLine).Replace(ChrW(92) &amp; ChrW(34), ChrW(34)).Replace(ChrW(92) &amp; ChrW(92), ChrW(92))&#xA;                horaPreviaPorPaso(numeroPasoPrevio) = coincidencia.Groups(5).Value&#xA;                If estadoPrevioNormalizado.Equals(&quot;En proceso&quot;, StringComparison.OrdinalIgnoreCase) Then&#xA;                    pasoEnProcesoPrevio = numeroPasoPrevio&#xA;                End If&#xA;            End If&#xA;        Next&#xA;    End If&#xA;&#xA;    Dim esNuevaEjecucion As Boolean = (pasoActualNumero = 1 AndAlso Not finalizarProcesoValor AndAlso String.IsNullOrWhiteSpace(mensajeErrorSeguro))&#xA;    Dim cierreConError As Boolean = (pasoActualNumero = pasosSeparados.Length AndAlso Not finalizarProcesoValor AndAlso pasoEnProcesoPrevio &gt; 0)&#xA;&#xA;    If esNuevaEjecucion Then&#xA;        inicioSprint = ahora&#xA;        estadoPrevioPorPaso.Clear()&#xA;        horaPreviaPorPaso.Clear()&#xA;        nombrePrevioPorPaso.Clear()&#xA;        descripcionPreviaPorPaso.Clear()&#xA;        pasoEnProcesoPrevio = 0&#xA;    ElseIf pasoEnProcesoPrevio &gt; 0 AndAlso (Not String.IsNullOrWhiteSpace(mensajeErrorSeguro) OrElse cierreConError) Then&#xA;        pasoActualNumero = pasoEnProcesoPrevio&#xA;    End If&#xA;&#xA;    Dim duracionSprint As TimeSpan = ahora - inicioSprint&#xA;    Dim duracionSegundos As Integer = CInt(Math.Floor(duracionSprint.TotalSeconds))&#xA;    Dim duracionTexto As String = duracionSprint.ToString(&quot;hh\:mm\:ss&quot;)&#xA;    Dim inicioTexto As String = If(String.IsNullOrWhiteSpace(If(i_pasoActual_Str, &quot;&quot;).Trim()) AndAlso Not finalizarProcesoValor, &quot;&quot;, inicioSprint.ToString(formatoFecha))&#xA;    Dim finTexto As String = &quot;&quot;&#xA;&#xA;    If finalizarProcesoValor Then&#xA;        finTexto = ahora.ToString(formatoFecha)&#xA;    End If&#xA;&#xA;    Dim escaparJson As System.Func(Of String, String) =&#xA;        Function(valor As String)&#xA;            Dim textoSeguro As String = If(valor, &quot;&quot;)&#xA;            Dim sbEscape As New System.Text.StringBuilder()&#xA;            For Each caracter As Char In textoSeguro&#xA;                Select Case caracter&#xA;                    Case &quot;\&quot;c&#xA;                        sbEscape.Append(ChrW(92)).Append(ChrW(92))&#xA;                    Case &quot;&quot;&quot;&quot;c&#xA;                        sbEscape.Append(ChrW(92)).Append(ChrW(34))&#xA;                    Case ControlChars.Cr&#xA;                        sbEscape.Append(ChrW(92)).Append(&quot;r&quot;)&#xA;                    Case ControlChars.Lf&#xA;                        sbEscape.Append(ChrW(92)).Append(&quot;n&quot;)&#xA;                    Case ControlChars.Tab&#xA;                        sbEscape.Append(ChrW(92)).Append(&quot;t&quot;)&#xA;                    Case ControlChars.Back&#xA;                        sbEscape.Append(ChrW(92)).Append(&quot;b&quot;)&#xA;                    Case ControlChars.FormFeed&#xA;                        sbEscape.Append(ChrW(92)).Append(&quot;f&quot;)&#xA;                    Case ChrW(&amp;H2028), ChrW(&amp;H2029)&#xA;                        sbEscape.Append(ChrW(92)).Append(&quot;u&quot;)&#xA;                        sbEscape.Append(AscW(caracter).ToString(&quot;X4&quot;))&#xA;                    Case Else&#xA;                        Dim codigoCaracter As Integer = AscW(caracter)&#xA;                        If codigoCaracter &lt; 32 Then&#xA;                            sbEscape.Append(ChrW(92)).Append(&quot;u&quot;)&#xA;                            sbEscape.Append(codigoCaracter.ToString(&quot;X4&quot;))&#xA;                        Else&#xA;                            sbEscape.Append(caracter)&#xA;                        End If&#xA;                End Select&#xA;            Next&#xA;            Return sbEscape.ToString()&#xA;        End Function&#xA;&#xA;    Dim nombreSprintJson As String = escaparJson(nombreSprintSeguro)&#xA;    Dim mensajeErrorJson As String = escaparJson(mensajeErrorSeguro)&#xA;    Dim sb As New System.Text.StringBuilder()&#xA;    sb.AppendLine(&quot;{&quot;)&#xA;    sb.AppendLine(&quot;  &quot;&quot;processName&quot;&quot;: &quot;&quot;&quot; &amp; nombreSprintJson &amp; &quot;&quot;&quot;,&quot;)&#xA;    sb.AppendLine(&quot;  &quot;&quot;startedAt&quot;&quot;: &quot;&quot;&quot; &amp; inicioTexto &amp; &quot;&quot;&quot;,&quot;)&#xA;    sb.AppendLine(&quot;  &quot;&quot;durationSeconds&quot;&quot;: &quot; &amp; duracionSegundos.ToString() &amp; &quot;,&quot;)&#xA;    sb.AppendLine(&quot;  &quot;&quot;durationLabel&quot;&quot;: &quot;&quot;&quot; &amp; duracionTexto &amp; &quot;&quot;&quot;,&quot;)&#xA;    sb.AppendLine(&quot;  &quot;&quot;completedAt&quot;&quot;: &quot;&quot;&quot; &amp; finTexto &amp; &quot;&quot;&quot;,&quot;)&#xA;    sb.AppendLine(&quot;  &quot;&quot;lastUpdated&quot;&quot;: &quot;&quot;&quot; &amp; horaActual &amp; &quot;&quot;&quot;,&quot;)&#xA;    sb.AppendLine(&quot;  &quot;&quot;lastDatabaseUpdate&quot;&quot;: &quot;&quot;&quot; &amp; horaActual &amp; &quot;&quot;&quot;,&quot;)&#xA;    sb.AppendLine(&quot;  &quot;&quot;errorMessage&quot;&quot;: &quot;&quot;&quot; &amp; mensajeErrorJson &amp; &quot;&quot;&quot;,&quot;)&#xA;    sb.AppendLine(&quot;  &quot;&quot;steps&quot;&quot;: [&quot;)&#xA;&#xA;    For i As Integer = 0 To pasosSeparados.Length - 1&#xA;        Dim numeroPaso As Integer = i + 1&#xA;        Dim esPasoActual As Boolean = (i = pasoActualNumero - 1)&#xA;        Dim estadoPaso As String = &quot;Sin comenzar&quot;&#xA;&#xA;        If Not esNuevaEjecucion AndAlso estadoPrevioPorPaso.ContainsKey(numeroPaso) AndAlso Not String.IsNullOrWhiteSpace(estadoPrevioPorPaso(numeroPaso)) Then&#xA;            estadoPaso = estadoPrevioPorPaso(numeroPaso)&#xA;        End If&#xA;&#xA;        If (Not String.IsNullOrWhiteSpace(mensajeErrorSeguro) OrElse cierreConError) AndAlso esPasoActual Then&#xA;            estadoPaso = &quot;Con error&quot;&#xA;        ElseIf finalizarProcesoValor Then&#xA;            If numeroPaso = pasoEnProcesoPrevio OrElse esPasoActual Then&#xA;                estadoPaso = &quot;Finalizado&quot;&#xA;            End If&#xA;        Else&#xA;            If pasoEnProcesoPrevio &gt; 0 AndAlso numeroPaso = pasoEnProcesoPrevio AndAlso Not esPasoActual Then&#xA;                estadoPaso = &quot;Finalizado&quot;&#xA;            End If&#xA;            If esPasoActual Then&#xA;                estadoPaso = &quot;En proceso&quot;&#xA;            End If&#xA;        End If&#xA;&#xA;        Dim nombrePaso As String = If(pasosSeparados(i), &quot;&quot;).Trim()&#xA;        Dim descripcionPaso As String = nombrePaso&#xA;        If i &lt; descripcionesSeparadas.Length AndAlso Not String.IsNullOrWhiteSpace(descripcionesSeparadas(i)) Then&#xA;            descripcionPaso = descripcionesSeparadas(i).Trim()&#xA;        End If&#xA;&#xA;        Dim conservarTextoPrevio As Boolean = Not esNuevaEjecucion AndAlso Not esPasoActual AndAlso estadoPrevioPorPaso.ContainsKey(numeroPaso) AndAlso Not estadoPrevioPorPaso(numeroPaso).Equals(&quot;Sin comenzar&quot;, StringComparison.OrdinalIgnoreCase)&#xA;        If conservarTextoPrevio Then&#xA;            If nombrePrevioPorPaso.ContainsKey(numeroPaso) AndAlso Not String.IsNullOrWhiteSpace(nombrePrevioPorPaso(numeroPaso)) Then&#xA;                nombrePaso = nombrePrevioPorPaso(numeroPaso)&#xA;            End If&#xA;            If descripcionPreviaPorPaso.ContainsKey(numeroPaso) AndAlso Not String.IsNullOrWhiteSpace(descripcionPreviaPorPaso(numeroPaso)) Then&#xA;                descripcionPaso = descripcionPreviaPorPaso(numeroPaso)&#xA;            End If&#xA;        End If&#xA;&#xA;        If (Not String.IsNullOrWhiteSpace(mensajeErrorSeguro) OrElse cierreConError) AndAlso esPasoActual Then&#xA;            descripcionPaso = If(String.IsNullOrWhiteSpace(mensajeErrorPantalla), &quot;la posible causa del error es: El robot reporto un error sin detalle.&quot;, mensajeErrorPantalla)&#xA;        End If&#xA;&#xA;        Dim estadoPrevio As String = &quot;&quot;&#xA;        Dim horaPrevia As String = &quot;--&quot;&#xA;        If estadoPrevioPorPaso.ContainsKey(numeroPaso) Then&#xA;            estadoPrevio = estadoPrevioPorPaso(numeroPaso)&#xA;        End If&#xA;        If horaPreviaPorPaso.ContainsKey(numeroPaso) AndAlso Not String.IsNullOrWhiteSpace(horaPreviaPorPaso(numeroPaso)) Then&#xA;            horaPrevia = horaPreviaPorPaso(numeroPaso)&#xA;        End If&#xA;&#xA;        Dim horaPaso As String = horaPrevia&#xA;        If estadoPaso &lt;&gt; estadoPrevio OrElse esPasoActual Then&#xA;            If estadoPaso = &quot;Sin comenzar&quot; Then&#xA;                horaPaso = &quot;--&quot;&#xA;            Else&#xA;                horaPaso = horaActual&#xA;            End If&#xA;        ElseIf String.IsNullOrWhiteSpace(horaPaso) Then&#xA;            horaPaso = &quot;--&quot;&#xA;        End If&#xA;&#xA;        nombrePaso = escaparJson(nombrePaso)&#xA;        descripcionPaso = escaparJson(descripcionPaso)&#xA;        horaPaso = escaparJson(horaPaso)&#xA;&#xA;        sb.AppendLine(&quot;    {&quot;)&#xA;        sb.AppendLine(&quot;      &quot;&quot;step_number&quot;&quot;: &quot; &amp; numeroPaso.ToString() &amp; &quot;,&quot;)&#xA;        sb.AppendLine(&quot;      &quot;&quot;step_name&quot;&quot;: &quot;&quot;&quot; &amp; nombrePaso &amp; &quot;&quot;&quot;,&quot;)&#xA;        sb.AppendLine(&quot;      &quot;&quot;status&quot;&quot;: &quot;&quot;&quot; &amp; estadoPaso &amp; &quot;&quot;&quot;,&quot;)&#xA;        sb.AppendLine(&quot;      &quot;&quot;description&quot;&quot;: &quot;&quot;&quot; &amp; descripcionPaso &amp; &quot;&quot;&quot;,&quot;)&#xA;        sb.AppendLine(&quot;      &quot;&quot;updated_at&quot;&quot;: &quot;&quot;&quot; &amp; horaPaso &amp; &quot;&quot;&quot;&quot;)&#xA;&#xA;        If i = pasosSeparados.Length - 1 Then&#xA;            sb.AppendLine(&quot;    }&quot;)&#xA;        Else&#xA;            sb.AppendLine(&quot;    },&quot;)&#xA;        End If&#xA;    Next&#xA;&#xA;    sb.AppendLine(&quot;  ]&quot;)&#xA;    sb.AppendLine(&quot;}&quot;)&#xA;    System.IO.File.WriteAllText(rutaArchivo, sb.ToString(), System.Text.Encoding.UTF8)&#xA;Catch ex As Exception&#xA;End Try" DisplayName="Construir JSON del sprint" sap:VirtualizedContainerService.HintSize="450,197" sap2010:WorkflowViewState.IdRef="InvokeCode_ActualizarPanelSprint">
